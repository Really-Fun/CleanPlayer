/* Глобальная типографика и каркас */

* {
    font-family: "Segoe UI", "Inter", sans-serif;
}

QWidget#appShell,
QWidget#appContent,
QWidget#bodyWithWallpaper,
QWidget#bodyForeground,
QWidget#wallpaperBackdrop,
QMainWindow,
QWidget#pageStack {
    background: transparent;
}

QScrollArea#settingsScroll {
    background: transparent;
    border: none;
}

QScrollArea#settingsScroll > QWidget > QWidget {
    background: transparent;
}

QListView#trackList,
QTableView#trackList {
    background: transparent;
    border: none;
    outline: none;
}

QListView#trackList::item {
    border: none;
    padding: 0;
    background: transparent;
}

QListView#trackList::item:selected {
    background: transparent;
}

/* Кастомная панель окна */
QFrame#appHeader {
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QFrame#appHeader QLabel#headerGreeting {
    font-size: 13px;
    font-weight: 600;
}

QToolButton#windowMinBtn,
QToolButton#windowMaxBtn,
QToolButton#windowCloseBtn {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0;
    margin: 0;
}

QToolButton#windowMinBtn:hover,
QToolButton#windowMaxBtn:hover {
    background: rgba(255, 255, 255, 0.08);
}

QToolButton#windowCloseBtn:hover {
    background: #e81123;
}

QToolButton#windowCloseBtn:pressed {
    background: #bf0f1d;
}

QLabel#headerBrandLogo {
    background: transparent;
    border: none;
}

QFrame#sideNavRail QToolButton#navIconButton {
    outline: none;
}
