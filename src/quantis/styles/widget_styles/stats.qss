/* Статистика прослушиваний */

QWidget#statsPage {
    background: transparent;
}

QWidget#statsMetrics {
    background: transparent;
}

QFrame#statsMetric {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
}

QLabel#statsMetricValue {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.6px;
    color: #f8fafc;
    background: transparent;
}

QLabel#statsMetricLabel {
    font-size: 12px;
    font-weight: 500;
    color: rgba(226, 232, 240, 0.48);
    background: transparent;
}

QWidget#listenBars {
    background: transparent;
    min-height: 48px;
}
