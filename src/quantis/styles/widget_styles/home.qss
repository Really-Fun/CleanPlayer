/* Главная — стриминговый shelf + hero */

QWidget#homePage,
QWidget#homeScrollContent,
QWidget#homeHero {
    background: transparent;
}

QScrollArea#homeScroll,
QScrollArea#playlistShelfScroll,
QScrollArea#quickPickShelfScroll {
    background: transparent;
    border: none;
}

QWidget#playlistShelfHost,
QWidget#quickPickShelfHost {
    background: transparent;
}

QLabel#homeKicker {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.2px;
    color: rgba(46, 230, 255, 0.85);
    background: transparent;
    padding: 0;
}

QLabel#homeGreeting {
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -1.4px;
    color: #f8fafc;
    padding: 0;
    background: transparent;
}

QLabel#homeGreetingSub {
    font-size: 14px;
    font-weight: 400;
    color: rgba(226, 232, 240, 0.52);
    letter-spacing: 0.15px;
    padding: 0 0 4px 0;
    background: transparent;
}

QWidget#homeSection {
    background: transparent;
}

QWidget#homeSectionBody {
    background: transparent;
}

QLabel#homeSectionTitle {
    font-size: 22px;
    font-weight: 700;
    color: #f4f8fb;
    letter-spacing: -0.45px;
    background: transparent;
}

QLabel#homeSectionSubtitle {
    font-size: 12px;
    color: rgba(226, 232, 240, 0.45);
    background: transparent;
}

QLabel#homeSectionBadge {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2px;
    color: rgba(226, 232, 240, 0.75);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    min-width: 20px;
    padding: 2px 8px;
    max-height: 20px;
}

QLabel#homePillBadge {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.25px;
    color: rgba(226, 232, 240, 0.82);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 2px 8px;
    max-height: 20px;
}

QLabel#homePillBadge[variant="wave"] {
    color: rgba(125, 211, 252, 0.95);
    background: rgba(46, 230, 255, 0.07);
    border-color: rgba(46, 230, 255, 0.2);
}

QLabel#homePillBadge[variant="continue"] {
    color: rgba(253, 186, 210, 0.95);
    background: rgba(255, 92, 122, 0.08);
    border-color: rgba(255, 92, 122, 0.22);
}

QLabel#homeEmptyHint {
    font-size: 13px;
    color: rgba(226, 232, 240, 0.42);
    padding: 16px 4px;
    background: transparent;
}

/* Карточки плейлистов — без тяжёлой рамки, акцент на обложке */
QFrame#playlistCard {
    background: transparent;
    border: none;
    border-radius: 0;
}

QFrame#playlistCard[hovered="true"] QLabel#playlistCardTitle {
    color: #2ee6ff;
}

QLabel#playlistCardTitle {
    font-size: 13px;
    font-weight: 650;
    color: #f8fafc;
    background: transparent;
}

QLabel#playlistCardMeta {
    font-size: 11px;
    color: rgba(226, 232, 240, 0.48);
    background: transparent;
}

/* Быстрые плитки — стекло, как «Моя волна» */
QFrame#quickPickTile {
    background: transparent;
    border: none;
    border-radius: 14px;
}

QLabel#quickPickTitle {
    font-size: 13px;
    font-weight: 650;
    color: #f8fafc;
    background: transparent;
}

QLabel#quickPickMeta {
    font-size: 11px;
    color: rgba(226, 232, 240, 0.48);
    background: transparent;
}

QToolButton#homeSectionAction {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 6px 12px;
    color: #e2e8f0;
    font-size: 12px;
    font-weight: 600;
}
QToolButton#homeSectionAction:hover {
    background: rgba(46, 230, 255, 0.16);
    border-color: rgba(46, 230, 255, 0.55);
    color: #f8fafc;
}

QTableView#homeTrackList {
    background: transparent;
    border: none;
    outline: none;
}

QTableView#homeTrackList::item {
    border: none;
    padding: 0;
    background: transparent;
}

QTableView#homeTrackList::item:selected {
    background: transparent;
}

QTableView#homeTrackList QScrollBar:vertical,
QTableView#homeTrackList QScrollBar:horizontal {
    width: 0;
    height: 0;
    background: transparent;
}

QScrollArea#playlistShelfScroll QScrollBar:horizontal,
QScrollArea#quickPickShelfScroll QScrollBar:horizontal {
    height: 6px;
    background: transparent;
    margin: 0 4px;
}
QScrollArea#playlistShelfScroll QScrollBar::handle:horizontal,
QScrollArea#quickPickShelfScroll QScrollBar::handle:horizontal {
    background: rgba(46, 230, 255, 0.35);
    border-radius: 3px;
    min-width: 40px;
}
QScrollArea#playlistShelfScroll QScrollBar::add-line:horizontal,
QScrollArea#playlistShelfScroll QScrollBar::sub-line:horizontal,
QScrollArea#quickPickShelfScroll QScrollBar::add-line:horizontal,
QScrollArea#quickPickShelfScroll QScrollBar::sub-line:horizontal {
    width: 0;
}

/* Hero featured */
QFrame#featuredPanel {
    background: transparent;
    border: none;
    border-radius: 14px;
    min-height: 108px;
    max-height: 120px;
}

QLabel#featuredCover {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    color: #2ee6ff;
    font-size: 28px;
    font-weight: 700;
}

QLabel#featuredTitle {
    font-size: 15px;
    font-weight: 650;
    letter-spacing: -0.2px;
    color: #f8fafc;
    background: transparent;
}

QLabel#featuredAuthor {
    font-size: 12px;
    color: rgba(226, 232, 240, 0.55);
    background: transparent;
}

QToolButton#featuredPlayBtn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 18px;
    color: #f8fafc;
    font-size: 13px;
    font-weight: 700;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    padding: 0;
}
QToolButton#featuredPlayBtn:hover {
    background: rgba(255, 92, 122, 0.18);
    border-color: rgba(255, 92, 122, 0.35);
    color: #ffe4ec;
}
QToolButton#featuredPlayBtn:disabled {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.06);
    color: rgba(248, 250, 252, 0.28);
}

/* Моя волна */
QFrame#wavePromoCard {
    background: transparent;
    border: none;
    border-radius: 14px;
}

QLabel#wavePromoSubtitle {
    font-size: 12px;
    color: rgba(226, 232, 240, 0.52);
    background: transparent;
}

QLabel#wavePromoCount {
    font-size: 10px;
    font-weight: 500;
    color: rgba(226, 232, 240, 0.45);
    background: transparent;
    padding: 0;
}

QToolButton#wavePromoPlayBtn {
    background: rgba(46, 230, 255, 0.1);
    border: 1px solid rgba(46, 230, 255, 0.22);
    border-radius: 18px;
    color: #b8f4ff;
    font-size: 12px;
    font-weight: 700;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    padding: 0;
}
QToolButton#wavePromoPlayBtn:hover {
    background: rgba(46, 230, 255, 0.18);
    border-color: rgba(46, 230, 255, 0.38);
    color: #e8fcff;
}
QToolButton#wavePromoPlayBtn:disabled {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.06);
    color: rgba(248, 250, 252, 0.28);
}
