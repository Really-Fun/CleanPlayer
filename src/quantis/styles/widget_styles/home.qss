/* Главная — без вложенных скроллов, плотная сетка */

QWidget#homePage,
QWidget#homeScrollContent {
    background: transparent;
}

QScrollArea#homeScroll {
    background: transparent;
    border: none;
}

QLabel#homeGreeting {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.7px;
    color: #f8fafc;
    padding: 6px 0 0 0;
    background: transparent;
}

QLabel#homeGreetingSub {
    font-size: 13px;
    font-weight: 400;
    color: rgba(226, 232, 240, 0.55);
    padding: 0 0 8px 0;
    background: transparent;
}

QWidget#homeSection {
    background: transparent;
}

QWidget#homeSectionBody {
    background: transparent;
}

QLabel#homeSectionTitle {
    font-size: 20px;
    font-weight: 750;
    color: #f8fafc;
    letter-spacing: -0.3px;
    background: transparent;
}

QLabel#homeSectionSubtitle {
    font-size: 12px;
    color: rgba(226, 232, 240, 0.5);
    background: transparent;
}

QLabel#homeEmptyHint {
    font-size: 13px;
    color: rgba(226, 232, 240, 0.45);
    padding: 12px 4px;
    background: transparent;
}

QFrame#playlistCard {
    background: rgba(15, 18, 28, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
}

QFrame#playlistCard:hover {
    background: rgba(22, 26, 40, 0.95);
    border-color: rgba(34, 211, 238, 0.35);
}

QLabel#playlistCardTitle {
    font-size: 13px;
    font-weight: 650;
    color: #f8fafc;
    background: transparent;
}

QLabel#playlistCardMeta {
    font-size: 11px;
    color: rgba(226, 232, 240, 0.5);
    background: transparent;
}

QFrame#quickPickTile {
    background: rgba(15, 18, 28, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
}

QFrame#quickPickTile:hover {
    background: rgba(22, 26, 40, 0.95);
    border-color: rgba(34, 211, 238, 0.3);
}

QLabel#quickPickTitle {
    font-size: 13px;
    font-weight: 650;
    color: #f8fafc;
    background: transparent;
}

QLabel#quickPickMeta {
    font-size: 11px;
    color: rgba(226, 232, 240, 0.48);
    background: transparent;
}

QTableView#homeTrackList {
    background: transparent;
    border: none;
    outline: none;
}

QTableView#homeTrackList::item {
    border: none;
    padding: 0;
    background: transparent;
}

QTableView#homeTrackList::item:selected {
    background: transparent;
}

QTableView#homeTrackList QScrollBar:vertical,
QTableView#homeTrackList QScrollBar:horizontal {
    width: 0;
    height: 0;
    background: transparent;
}

QFrame#featuredPanel {
    background: rgba(15, 18, 28, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    min-height: 180px;
    max-height: 240px;
}
