/* Структура плеера — цвета в themes/<theme>/play_menu.qss */

QWidget#playerLeft,
QWidget#playerCenter,
QWidget#playerRight {
    background: transparent;
}

#trackTitle {
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}
#trackArtist {
    font-size: 11px;
    background: transparent;
}
#timeLabel {
    font-size: 10px;
    font-family: "Cascadia Mono", "Consolas", monospace;
    background: transparent;
}
#coverLabel {
    border-radius: 8px;
    min-width: 48px;
    max-width: 48px;
    min-height: 48px;
    max-height: 48px;
}

#seekSlider::groove:horizontal,
#volSlider::groove:horizontal {
    height: 3px;
    border-radius: 2px;
}
#seekSlider::handle:horizontal {
    width: 10px;
    height: 10px;
    margin: -4px 0;
    border-radius: 5px;
}
#volSlider::handle:horizontal {
    width: 9px;
    height: 9px;
    margin: -3px 0;
    border-radius: 5px;
}

#controlButton {
    border: none;
    border-radius: 17px;
}
#controlButton[accent=true] {
    border-radius: 22px;
}

#PlayMenu QLabel {
    background: transparent;
}

#controlButton[liked="true"] {
    background: rgba(255, 77, 109, 0.18);
}
