/* Структура плеера — цвета задаются в themes/<theme>/play_menu.qss */

QFrame#playerDock {
    background: transparent;
    border: none;
}

#trackTitle {
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}
#trackArtist {
    font-size: 11px;
    background: transparent;
}
#timeLabel {
    font-size: 10px;
    font-family: "Cascadia Mono", "Consolas", monospace;
    background: transparent;
    min-width: 36px;
}
#coverLabel {
    border-radius: 8px;
    min-width: 48px;
    max-width: 48px;
    min-height: 48px;
    max-height: 48px;
}
#volIcon {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
    background: transparent;
    min-width: 24px;
}

#seekSlider::groove:horizontal,
#volSlider::groove:horizontal {
    height: 4px;
    border-radius: 2px;
}
#seekSlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}
#volSlider::handle:horizontal {
    width: 10px;
    height: 10px;
    margin: -3px 0;
    border-radius: 5px;
}

#controlButton {
    border: none;
    border-radius: 18px;
}
#controlButton[accent=true] {
    border-radius: 23px;
}

#PlayMenu QLabel {
    background: transparent;
}
