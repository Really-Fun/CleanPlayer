QFrame#sideNavRail {
    background: rgba(8, 10, 16, 0.6);
    border: none;
}

QToolButton#navIconButton {
    background: transparent;
    border: none;
    border-radius: 12px;
    padding: 10px;
    min-width: 44px;
    min-height: 44px;
}

QToolButton#navIconButton:hover {
    background: rgba(255, 255, 255, 0.05);
}

QToolButton#navIconButton:checked {
    background: rgba(58, 168, 216, 0.16);
}

QToolButton#navIconButton:pressed {
    background: rgba(58, 168, 216, 0.22);
}
