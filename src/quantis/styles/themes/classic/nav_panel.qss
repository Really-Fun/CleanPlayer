QFrame#sideNavRail {
    background: rgba(8, 10, 16, 0.88);
    border: none;
    border-right: 1px solid rgba(0, 200, 255, 0.1);
}
QToolButton#navLogoMark {
    background: rgba(0, 200, 255, 0.08);
    border: 1px solid rgba(0, 200, 255, 0.22);
    border-radius: 12px; padding: 6px; min-width: 40px; min-height: 40px;
}
QToolButton#navIconButton {
    background: transparent; border: none; border-radius: 10px;
    padding: 8px; min-width: 42px; min-height: 42px;
}
QToolButton#navIconButton:hover { background: rgba(0, 200, 255, 0.08); }
QToolButton#navIconButton:checked {
    background: rgba(0, 200, 255, 0.12);
    border-left: 3px solid #00c8ff;
    border-radius: 0 10px 10px 0; padding-left: 5px;
}
