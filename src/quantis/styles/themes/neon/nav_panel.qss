QFrame#sideNavRail {
    background: rgba(6, 6, 14, 0.9);
    border: none;
    border-right: 1px solid rgba(255, 42, 127, 0.12);
}

QToolButton#navLogoMark {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(255,42,127,0.2), stop:1 rgba(0,229,255,0.2));
    border: 1px solid rgba(0, 229, 255, 0.35);
    border-radius: 12px;
    padding: 6px;
    min-width: 40px;
    min-height: 40px;
}

QToolButton#navIconButton {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 8px;
    min-width: 42px;
    min-height: 42px;
}

QToolButton#navIconButton:hover {
    background: rgba(255, 42, 127, 0.1);
}

QToolButton#navIconButton:checked {
    background: rgba(0, 229, 255, 0.12);
    border-left: 3px solid #ff2a7f;
    border-radius: 0 10px 10px 0;
    padding-left: 5px;
}
