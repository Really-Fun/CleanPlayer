QFrame#sideNavRail {
    background: rgba(5, 5, 12, 0.55);
    border: none;
}

QToolButton#navIconButton {
    background: transparent;
    border: none;
    border-radius: 12px;
    padding: 10px;
    min-width: 44px;
    min-height: 44px;
}

QToolButton#navIconButton:hover {
    background: rgba(255, 255, 255, 0.06);
}

QToolButton#navIconButton:checked {
    background: rgba(0, 229, 255, 0.14);
}

QToolButton#navIconButton:pressed {
    background: rgba(255, 42, 127, 0.12);
}
