QFrame#sideNavRail {
    border: 1px solid rgba(46, 230, 255, 0.14);
}

QToolButton#navIconButton {
    background: transparent;
    border: none;
    border-radius: 14px;
    padding: 11px;
    min-width: 46px;
    min-height: 46px;
}

QToolButton#navIconButton:hover {
    background: rgba(255, 255, 255, 0.07);
}

QToolButton#navIconButton:checked {
    background: transparent;
}

QToolButton#navIconButton:pressed {
    background: rgba(255, 92, 122, 0.14);
}
