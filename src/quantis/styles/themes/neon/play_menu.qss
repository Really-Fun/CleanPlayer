/* Neon player — акцент поверх surfaces.qss */

#PlayMenu {
    border-top: 2px solid rgba(0, 229, 255, 0.35);
}

#trackTitle { color: #f8fafc; }
#trackTitle[playing="true"] { color: #00e5ff; }
#trackArtist { color: rgba(0, 229, 255, 0.55); }
#timeLabel { color: rgba(248, 250, 252, 0.45); }

#seekSlider::groove:horizontal,
#volSlider::groove:horizontal {
    background: rgba(255, 255, 255, 0.1);
}
#seekSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #ff2a7f, stop:1 #00e5ff);
    border-radius: 2px;
}
#seekSlider::handle:horizontal {
    background: #00e5ff;
    border: 1px solid rgba(255, 255, 255, 0.2);
}
#seekSlider::handle:horizontal:hover { background: #ff2a7f; }

#volSlider::sub-page:horizontal { background: rgba(0, 229, 255, 0.5); border-radius: 2px; }
#volSlider::handle:horizontal { background: #f8fafc; }

#controlButton { background: transparent; color: #f8fafc; }
#controlButton:hover { background: rgba(0, 229, 255, 0.12); }
#controlButton[accent=true] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ff2a7f, stop:1 #00e5ff);
}
#controlButton[accent=true]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ff4d94, stop:1 #33ecff);
}
