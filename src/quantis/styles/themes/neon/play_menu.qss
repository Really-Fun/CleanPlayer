/* Neon player — floating glass dock */

#PlayMenu {
    background: rgba(8, 12, 24, 0.88);
    border: 1px solid rgba(46, 230, 255, 0.16);
    border-radius: 22px;
}

#trackTitle {
    color: #f4f8fb;
    font-size: 14px;
    font-weight: 650;
}
#trackTitle[playing="true"] { color: #2ee6ff; }
#trackArtist { color: rgba(46, 230, 255, 0.55); font-size: 12px; }
#timeLabel { color: rgba(238, 244, 248, 0.42); }

#seekSlider::groove:horizontal,
#volSlider::groove:horizontal {
    background: rgba(255, 255, 255, 0.08);
    height: 4px;
    border-radius: 2px;
}
#seekSlider::sub-page:horizontal {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #ff5c7a, stop:1 #2ee6ff
    );
    border-radius: 2px;
}
#seekSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #2ee6ff;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
}
#seekSlider::handle:horizontal:hover {
    background: #2ee6ff;
    border-color: #ffffff;
}

#volSlider::sub-page:horizontal {
    background: rgba(46, 230, 255, 0.55);
    border-radius: 2px;
}
#volSlider::handle:horizontal {
    background: #f8fafc;
    width: 10px;
    height: 10px;
    margin: -4px 0;
    border-radius: 5px;
}

#controlButton {
    background: transparent;
    color: #f8fafc;
    border-radius: 18px;
}
#controlButton:hover {
    background: rgba(46, 230, 255, 0.14);
}
#controlButton[accent=true] {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #ff5c7a, stop:1 #2ee6ff
    );
    border-radius: 24px;
}
#controlButton[accent=true]:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #ff7a94, stop:1 #5ff0ff
    );
}
#controlButton[liked="true"] {
    background: rgba(255, 92, 122, 0.22);
}
