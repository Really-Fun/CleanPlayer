QFrame#sideNavRail {
    background: rgba(12, 9, 5, 0.9);
    border: none;
    border-right: 1px solid rgba(255, 170, 0, 0.1);
}
QToolButton#navLogoMark {
    background: rgba(255, 170, 0, 0.1);
    border: 1px solid rgba(255, 170, 0, 0.25);
    border-radius: 12px; padding: 6px;
}
QToolButton#navIconButton {
    background: transparent; border: none; border-radius: 10px;
    padding: 8px; min-width: 42px; min-height: 42px;
}
QToolButton#navIconButton:hover { background: rgba(255, 170, 0, 0.08); }
QToolButton#navIconButton:checked {
    background: rgba(255, 170, 0, 0.14);
    border-left: 3px solid #ffaa00;
    border-radius: 0 10px 10px 0; padding-left: 5px;
}
