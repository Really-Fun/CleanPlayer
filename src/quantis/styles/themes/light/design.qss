/* Light — мягкий серо-голубой, не белая вспышка */

QWidget { color: #2a3038; }

QFrame#glassPanel {
    background: rgba(48, 54, 64, 0.55);
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 14px;
}

QFrame#appHeader {
    background: rgba(40, 44, 52, 0.5);
    border: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
}

#headerGreeting {
    font-size: 20px;
    font-weight: 700;
    color: #f0f3f6;
}

#sectionTitle {
    font-size: 12px;
    font-weight: 600;
    color: rgba(220, 228, 236, 0.65);
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

#searchInput {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 14px;
    color: #f0f3f6;
}
#searchInput:focus {
    border-color: rgba(94, 179, 232, 0.55);
    background: rgba(0, 0, 0, 0.28);
}

QPushButton#searchButton {
    background: rgba(94, 179, 232, 0.25);
    border: 1px solid rgba(94, 179, 232, 0.4);
    border-radius: 10px;
    color: #f0f3f6;
    font-weight: 600;
    padding: 8px 16px;
}
QPushButton#searchButton:hover {
    background: rgba(94, 179, 232, 0.4);
}

#searchStatus { color: rgba(200, 208, 218, 0.7); font-size: 11px; }

QLabel#settingsSectionLabel {
    font-size: 11px;
    font-weight: 700;
    color: rgba(94, 179, 232, 0.85);
    letter-spacing: 1.5px;
    text-transform: uppercase;
}
QLabel#settingsRowTitle { color: #f0f3f6; font-size: 14px; font-weight: 600; }
QLabel#settingsRowDesc { color: rgba(200, 208, 218, 0.65); font-size: 12px; }
QCheckBox#settingsCheck { font-size: 13px; color: #dce4ec; }

QComboBox#themeCombo, QLineEdit#settingLineEdit {
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 10px 12px;
    color: #f0f3f6;
}
QComboBox#themeCombo QAbstractItemView {
    background: #2a3038;
    color: #f0f3f6;
    border: 1px solid rgba(0, 0, 0, 0.15);
    selection-background-color: rgba(94, 179, 232, 0.35);
}

QFrame#featuredPanel {
    background: rgba(44, 48, 56, 0.55);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 14px;
}

QScrollBar:vertical { width: 4px; background: transparent; }
QScrollBar::handle:vertical {
    background: rgba(94, 179, 232, 0.45);
    min-height: 40px;
    border-radius: 2px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
