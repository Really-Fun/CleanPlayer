QFrame#sideNavRail {
    background: rgba(36, 40, 48, 0.75);
    border: none;
    border-right: 1px solid rgba(0, 0, 0, 0.12);
}
QToolButton#navLogoMark {
    background: rgba(94, 179, 232, 0.15);
    border: 1px solid rgba(94, 179, 232, 0.3);
    border-radius: 12px;
    padding: 6px;
}
QToolButton#navIconButton {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 8px;
    min-width: 42px;
    min-height: 42px;
}
QToolButton#navIconButton:hover { background: rgba(255, 255, 255, 0.06); }
QToolButton#navIconButton:checked {
    background: rgba(94, 179, 232, 0.18);
    border-left: 3px solid #5eb3e8;
    border-radius: 0 10px 10px 0;
    padding-left: 5px;
}
