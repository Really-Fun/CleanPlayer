/* Editorial player — в стиле «Сейчас играет» */

#PlayMenu {
    background: #0c0c0e;
    border: 1px solid rgba(0, 229, 255, 0.25);
    border-radius: 0;
}

#trackTitle {
    color: #f2f0eb;
    font-family: Georgia, serif;
    font-size: 13px;
    font-weight: 400;
}
#trackArtist {
    color: rgba(242, 240, 235, 0.45);
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 9px;
    letter-spacing: 1px;
    text-transform: uppercase;
}
#timeLabel {
    color: rgba(242, 240, 235, 0.4);
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
}
#coverLabel {
    background: rgba(0, 229, 255, 0.06);
    border: 1px solid rgba(0, 229, 255, 0.2);
    border-radius: 0;
}
#volIcon {
    color: rgba(0, 229, 255, 0.6);
    font-family: "Cascadia Mono", Consolas, monospace;
}

#seekSlider::groove:horizontal,
#volSlider::groove:horizontal {
    background: rgba(255, 255, 255, 0.08);
    height: 3px;
    border-radius: 0;
}
#seekSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00e5ff, stop:1 #e63b2e);
    border-radius: 0;
}
#seekSlider::handle:horizontal {
    background: #f2f0eb;
    width: 8px;
    height: 8px;
    margin: -3px 0;
    border-radius: 0;
}
#volSlider::sub-page:horizontal {
    background: rgba(0, 229, 255, 0.45);
    border-radius: 0;
}
#volSlider::handle:horizontal {
    background: #f2f0eb;
    width: 8px;
    height: 8px;
    margin: -3px 0;
    border-radius: 0;
}

#controlButton {
    background: transparent;
    border-radius: 0;
}
#controlButton:hover {
    background: rgba(0, 229, 255, 0.08);
}
#controlButton[accent=true] {
    background: #e63b2e;
    color: #ffffff;
    border-radius: 0;
}
#controlButton[accent=true]:hover {
    background: #f04a3d;
}
